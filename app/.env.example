# MeetGPT macOS — build-time secrets.
# Copy to app/.env and fill in. app/build.sh bakes these into a gitignored
# Secrets.swift at build time. app/.env is gitignored — never commit real keys.

# LLM providers (used by the tier-gated model chooser)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# Chinese providers — for the ensemble/council mode (all OpenAI-compatible).
# DeepSeek: platform.deepseek.com · Qwen: modelstudio (DashScope intl) ·
# Zhipu GLM: z.ai · Moonshot Kimi: platform.moonshot.ai
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
MOONSHOT_API_KEY=

# HubSpot connected app (Connected apps → HubSpot). HubSpot's MCP has no
# dynamic client registration, so create an app in the HubSpot developer
# console, add redirect URL http://127.0.0.1:52700/callback, and paste:
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# Affinity hosted MCP (pre-registered app; redirect http://127.0.0.1:52701/callback)
AFFINITY_CLIENT_ID=
AFFINITY_CLIENT_SECRET=
# Zoom hosted MCP (pre-registered app; redirect http://127.0.0.1:52702/callback)
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Asana hosted MCP V2 (pre-registered MCP app; no dynamic registration).
# Register exactly http://127.0.0.1:52703/callback. Never commit or share the
# client secret; use a separate tester app or a private local .env.
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=

# Gmail via Google's hosted MCP (https://gmailmcp.googleapis.com/mcp/v1).
# Create a Desktop-app OAuth client in a SEPARATE Google Cloud project — do not
# reuse GOOGLE_CLIENT_ID below. Reading mail needs Restricted scopes
# (gmail.readonly, gmail.compose), which subject that project's consent screen
# to an annual third-party CASA security assessment. A separate project keeps
# sign-in and the Calendar/Docs/Sheets grant in the cheaper Sensitive tier.
# No redirect URI to register: Desktop clients accept any 127.0.0.1 port.
# Scopes requested are capped in code to readonly + labels + compose — never
# gmail.modify and never https://mail.google.com/ (permanent delete).
# Sign-in-only Google client, from a Cloud project whose consent screen asks
# ONLY for openid/email/profile. Such a screen publishes with no verification
# review, so anyone can sign up; the connector client's screen requests
# sensitive scopes and stays in Testing until Google reviews it, which admits
# only listed test accounts. Leave blank to reuse GOOGLE_CLIENT_ID.
GOOGLE_SIGNIN_CLIENT_ID=
GOOGLE_SIGNIN_CLIENT_SECRET=

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Google Analytics via Google's hosted GA4 Data API MCP
# (https://analyticsdata.googleapis.com/mcp/v1 — run_report, run_realtime_report).
# Desktop-app OAuth client, again in its OWN Cloud project, separate from both
# GOOGLE_CLIENT_ID and GMAIL_CLIENT_ID.
#
# Scope requested is capped in code to analytics.readonly. The server also offers
# plain `analytics`, which is READ-WRITE over your GA configuration; the selector
# refuses it.
#
# UNVERIFIED at the time of writing: whether analytics.readonly is Sensitive
# (free verification) or Restricted (annual third-party CASA). Google's list sits
# behind the OAuth Verification FAQ. Check before publishing: Cloud Console ->
# APIs & Services -> OAuth consent screen -> Data Access, add the scope, and the
# table labels it. A separate project keeps the answer from mattering to sign-in.
GOOGLE_ANALYTICS_CLIENT_ID=
GOOGLE_ANALYTICS_CLIENT_SECRET=

# Team token connectors — the no-MCP fallback (Slack bot / Confluence). Designated channels are comma-separated channel IDs. The channel
# watcher (Settings → Team watch) scans them for your keyword rules, notifies,
# logs to team-watch.log, and can auto-acknowledge (TEAM_WATCH_AUTO_ACK=on).
SLACK_BOT_TOKEN=
SLACK_CHANNEL_IDS=
# Confluence via token (prefer the Atlassian entry in Connected apps when possible)
CONFLUENCE_SITE=
CONFLUENCE_EMAIL=
CONFLUENCE_TOKEN=
TEAM_WATCH_AUTO_ACK=off

# Transcription. Both keys are optional BYO overrides that bill YOUR vendor
# accounts directly. Leave DEEPGRAM_API_KEY empty to stream through the
# backend's token grant instead — signed-in users pay from their shared
# compute credits at the deepgram chunk rate (dist builds ship keyless).
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=

# Google OAuth Desktop-app client for Calendar, Docs, Sheets, Slides, Forms and
# Drive. Enable all six APIs in the Cloud project. Imports are read-only and
# explicit-link; drive.file is used only for files this app creates. Local/test
# builds may inject these values; MEETGPT_DIST=1 scrubs them from public builds.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Backend base URL for the gateway / brainstormer / fact-check endpoints.
# Required with LLM_GATEWAY=backend: empty or `off` means no cloud LLM at all.
# Use http://localhost:8787 for a local server; `off` only for a keys-baked
# direct-mode build with no backend deployed.
BACKEND_URL=https://api.cruxwing.ai

# Optional TLS cert pinning for the backend host (defense against a rogue CA on
# the token-carrying channel). Comma-separated base64 SHA-256 of the backend's
# LEAF certificate (DER). Empty = standard system trust (default, no pinning).
# Compute:  echo | openssl s_client -connect HOST:443 -servername HOST 2>/dev/null \
#             | openssl x509 -outform der | openssl dgst -sha256 -binary | base64
BACKEND_CERT_PINS=

# How chat is served: direct (provider keys above, default) | backend (the
# managed /api/llm/chat gateway — keys stay server-side, tiers enforced there).
LLM_GATEWAY=direct

# Council mode (LLM_GATEWAY=ensemble): the same request is answered by a panel
# mixing US + Chinese models, then a chairman synthesizes one streamed answer.
# Needs keys above for every provider in the panel. NOTE: the panel sends your
# meeting content to every listed provider — a deliberate privacy trade-off.
# ENSEMBLE_PANEL=openAI/gpt-5.5,anthropic/claude-fable-5,deepSeek/deepseek-v4-pro,qwen/qwen3.7-max,zhipu/glm-5.2
# ENSEMBLE_CHAIRMAN=anthropic/claude-fable-5

# Transcription. Engine: local (on-device WhisperKit — DEFAULT, audio never
# leaves the Mac) | whisper (OpenAI Whisper cloud) | deepgram (cloud streaming).
# `server` (Cruxwing large-v3) is wired in code but hidden until VPS deploy.
# Chunk seconds 2–15 (local/whisper only). Default: local, 6.
TRANSCRIPTION_ENGINE=local
TRANSCRIPTION_CHUNK_SECONDS=6

# Local engine (TRANSCRIPTION_ENGINE=local): WhisperKit model, downloaded on
# first use and cached. tiny | base | small | large-v3 (default base).
TRANSCRIPTION_LOCAL_MODEL=base

# Voice-activity detection: silent chunks are skipped before transcription
# (saves API cost / local compute). on | off (default on).
TRANSCRIPTION_VAD=on

# Baseline plan tier: free | pro | premium. The user can't pick their plan in
# the app (it's set by subscription/usage); this is the operator/dev baseline.
DEFAULT_TIER=free

# Live transcription language. "multi" detects each voiced segment and adapts
# when speakers switch among the supported languages; use a fixed code to pin it.
TRANSCRIPTION_LANGUAGE=multi
